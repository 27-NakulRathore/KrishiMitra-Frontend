# Copy this file to .env and fill in real values.
#
# WARNING: Vite inlines every VITE_* variable into the built JavaScript bundle. Anything here is
# PUBLIC — readable by any visitor in DevTools. Never put a billable or privileged key in this
# file. Keys that must stay secret belong in the backend's environment, with the browser calling
# a backend endpoint that holds them (see GEMINI_API_KEY / NEWS_API_KEY in the backend's
# .env.example, reached via /api/ai/* and /api/news/*).

# Backend API base URL
VITE_API_URL=http://localhost:8080

# data.gov.in API key (mandi price lookups)
VITE_GOV_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# OpenWeatherMap API key
VITE_OPENWEATHER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
