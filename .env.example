# Copy this file to .env and fill in real values.
# Vite only exposes variables prefixed with VITE_ to the client bundle.

# Backend API base URL
VITE_API_URL=http://localhost:8080

# Google Gemini API key (used for client-side disease detection / listing pricing)
VITE_GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# data.gov.in API key (mandi price lookups)
VITE_GOV_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# OpenWeatherMap API key
VITE_OPENWEATHER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
